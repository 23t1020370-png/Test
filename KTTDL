from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

app = FastAPI(title="Binary Converter UI", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ==================== LOGIC XỬ LÝ NHỊ PHÂN ====================
def text_to_binary(text: str) -> tuple[str, str]:
    binary_list = [format(ord(char), "08b") for char in text]
    return " ".join(binary_list), "".join(binary_list)

def binary_to_text(binary_str: str) -> str:
    cleaned = binary_str.replace(" ", "").strip()
    if len(cleaned) % 8 != 0:
        raise ValueError("Độ dài dãy nhị phân phải chia hết cho 8.")
    if not set(cleaned).issubset({"0", "1"}):
        raise ValueError("Dãy nhị phân chỉ được chứa các ký tự 0 và 1.")
    bytes_list = [cleaned[i:i+8] for i in range(0, len(cleaned), 8)]
    return "".join(chr(int(b, 2)) for b in bytes_list)

# ==================== SCHEMAS ====================
class EncodeRequest(BaseModel):
    text: str = Field(..., examples=["CNTTK47"])

class DecodeRequest(BaseModel):
    binary: str = Field(..., examples=["01000011 01001110"])

# ==================== API ENDPOINTS ====================
@app.post("/api/binary/encode")
def encode_binary(payload: EncodeRequest):
    if not payload.text:
        raise HTTPException(status_code=400, detail="Vui lòng nhập văn bản.")
    spaced, continuous = text_to_binary(payload.text)
    return {"original": payload.text, "binary_spaced": spaced, "binary_continuous": continuous}

@app.post("/api/binary/decode")
def decode_binary(payload: DecodeRequest):
    try:
        return {"binary_input": payload.binary, "decoded_text": binary_to_text(payload.binary)}
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

