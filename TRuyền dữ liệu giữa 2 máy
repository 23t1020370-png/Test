<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mô phỏng truyền dữ liệu tin cậy</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 32px auto;
      padding: 0 16px;
      color: #1f2937;
    }

    .controls, .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin: 20px 0;
    }

    label {
      display: grid;
      gap: 6px;
    }

    button, select, input {
      padding: 8px;
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    #network {
       min-height: 220px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        background: #f8fafc;
    }

    .node {
      padding: 16px;
        border-radius: 8px;
        background: #dbeafe;
        font-weight: bold;
        white-space: nowrap;
        z-index: 1;
    }

    .lane {
  position: relative;
  flex: 1;
  height: 100%;
  min-height: 180px;
  margin: 0 16px;
}

.track {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4px;
  background: #94a3b8;
}

.packet {
  position: absolute;
  top: calc(50% - 18px);
  left: 0;
  z-index: 2;
  padding: 8px 10px;
  border-radius: 6px;
  background: #fbbf24;
  font-size: 13px;
  font-weight: bold;
  white-space: nowrap;
  transition-property: left;
  transition-timing-function: linear;
}
.packet.lost {
  background: #ef4444;
  color: white;
}
.packet.ack {
  background: #22c55e;
  color: white;
}
  </style>
</head>
<body>
  <h1>Mô phỏng truyền dữ liệu tin cậy</h1>
  <p>So sánh Stop-and-Wait, Go-Back-N và Selective Repeat.</p>

  <section class="controls">
    <label>
      Giao thức
      <select id="protocol">
        <option value="stopwait">Stop-and-Wait</option>
        <option value="gobackn">Go-Back-N</option>
        <option value="selective">Selective Repeat</option>
      </select>
    </label>

    <label>
      Số gói tin
      <input id="packetCount" type="number" min="1" max="30" value="10">
    </label>

    <label>
      Tỉ lệ mất gói (%)
      <input id="lossRate" type="number" min="0" max="80" value="20">
    </label>

    <label>
      Độ trễ mỗi chiều (ms)
      <input id="delay" type="number" min="100" max="3000" step="100" value="700">
    </label>

    <button id="startButton">Chạy mô phỏng</button>
    <button id="resetButton">Đặt lại</button>
  </section>

 <section id="network">
  <div class="node">Người gửi</div>

  <div class="lane">
    <div class="track"></div>
    <div id="packetLayer"></div>
  </div>

  <div class="node">Người nhận</div>
</section>

  <section class="stats">
    <div class="stat">Thời gian: <strong id="timeStat">0 giây</strong></div>
    <div class="stat">Đã gửi: <strong id="sentStat">0</strong></div>
    <div class="stat">Gửi lại: <strong id="retryStat">0</strong></div>
    <div class="stat">Đã nhận: <strong id="receivedStat">0</strong></div>
  </section>

  <h2>Nhật ký mô phỏng</h2>
  <div id="log">Sẵn sàng.</div>

<script>
  const startButton = document.querySelector("#startButton");
  const resetButton = document.querySelector("#resetButton");
  const packetLayer = document.querySelector("#packetLayer");
  const log = document.querySelector("#log");

  let runId = 0;
  let running = false;

  const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  startButton.addEventListener("click", async () => {
  if (running) return;

  running = true;
  startButton.disabled = true;

  const thisRun = ++runId;
  const count = Math.max(
    1,
    Math.min(30, Number(document.querySelector("#packetCount").value) || 1)
  );
  const delay = Math.max(
    100,
    Number(document.querySelector("#delay").value) || 700
  );
  const lossRate = Math.max(
    0,
    Math.min(80, Number(document.querySelector("#lossRate").value) || 0)
  );

  let sent = 0;
  let received = 0;
  let retries = 0;
  const startTime = performance.now();

  packetLayer.replaceChildren();
  document.querySelector("#sentStat").textContent = "0";
  document.querySelector("#retryStat").textContent = "0";
  document.querySelector("#receivedStat").textContent = "0";
  log.textContent = "Bắt đầu mô phỏng Stop-and-Wait...";

  for (let i = 1; i <= count; i++) {
    let delivered = false;
    let attempts = 0;

    // Thử gửi lại tối đa 20 lần cho mỗi gói.
    while (!delivered && attempts < 20) {
      if (thisRun !== runId) return;

      attempts++;
      sent++;

      if (attempts > 1) {
        retries++;
        document.querySelector("#retryStat").textContent = retries;
      }

      document.querySelector("#sentStat").textContent = sent;

      const packet = document.createElement("div");
      packet.className = "packet";
      packet.textContent = `Gói ${i}`;
      packet.style.transitionDuration = `${delay}ms`;
      packetLayer.appendChild(packet);

      packet.getBoundingClientRect();

      // Mỗi lần gửi sẽ có xác suất bị mất theo tỉ lệ đã chọn.
      const isLost = Math.random() * 100 < lossRate;

      if (isLost) {
        packet.style.left = "45%";
        log.textContent += `\nGói ${i} bị mất. Chờ timeout...`;

        await wait(delay);
        if (thisRun !== runId) return;

        packet.classList.add("lost");
        packet.textContent = `Mất gói ${i}`;

        await wait(delay);
        if (thisRun !== runId) return;

        packet.remove();
        log.textContent += `\nTimeout: gửi lại gói ${i}.`;
      } else {
        packet.style.left = "calc(100% - 52px)";
        log.textContent += `\nĐang gửi gói ${i}...`;

        await wait(delay);
        if (thisRun !== runId) return;

        packet.remove();
        delivered = true;
        received++;

        document.querySelector("#receivedStat").textContent = received;
        log.textContent += `\nNgười nhận đã nhận gói ${i}.`;
      }

      const seconds = (performance.now() - startTime) / 1000;
      document.querySelector("#timeStat").textContent =
        `${seconds.toFixed(1)} giây`;
    }

    if (!delivered) {
      log.textContent += `\nKhông gửi được gói ${i} sau 20 lần thử.`;
      break;
    }
  }

  if (received === count) {
    log.textContent += "\nHoàn tất gửi dữ liệu.";
  }

  if (thisRun === runId) {
    running = false;
    startButton.disabled = false;
  }
});

  resetButton.addEventListener("click", () => {
    // Tăng mã để dừng lượt mô phỏng đang chạy.
    runId++;
    running = false;
    startButton.disabled = false;

    packetLayer.replaceChildren();
    document.querySelector("#timeStat").textContent = "0 giây";
    document.querySelector("#sentStat").textContent = "0";
    document.querySelector("#retryStat").textContent = "0";
    document.querySelector("#receivedStat").textContent = "0";
    log.textContent = "Sẵn sàng.";
  });
</script>
</body>
</html>
